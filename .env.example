# Скопируйте этот файл в .env и заполните реальными значениями перед запуском docker compose up

# --- PostgreSQL (изолированная БД, доступна только контейнеру backend) ---
POSTGRES_DB=equipment_tracker
POSTGRES_USER=equipment_tracker
POSTGRES_PASSWORD=change_me_strong_db_password

# --- JWT ---
# Сгенерируйте случайную строку не короче 32 символов, например: openssl rand -base64 48
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars

# --- Стандартная учётная запись администратора, создаваемая при первом запуске ---
DEFAULT_ADMIN_LOGIN=admin
DEFAULT_ADMIN_PASSWORD=change_me_admin_password
DEFAULT_ADMIN_FULLNAME=Администратор

# --- Реквизиты для шапки инвентарных карточек (Excel-экспорт) ---
EXPORT_ORGANIZATION_NAME=ЧЕТВЁРТЫЙ КАССАЦИОННЫЙ СУД ОБЩЕЙ ЮРИСДИКЦИИ
EXPORT_OKPO_CODE=32717350

# --- Сеть ---
# Backend наружу не публикуется: API доступен браузеру по тому же адресу, что и фронтенд (/api/),
# поэтому адреса API и настройки CORS здесь не нужны.

# --- Порты, пробрасываемые наружу ---
# Для HTTPS порт 80 должен остаться 80: Let's Encrypt проверяет сервер именно на нём
FRONTEND_PORT=80
FRONTEND_HTTPS_PORT=443

# --- HTTPS (сертификат Let's Encrypt на IP-адрес, сервис certbot) ---
# Внешний IP-адрес сервера. Пусто — сайт работает по HTTP, certbot простаивает.
# Сертификат живёт ~6 дней и продлевается автоматически; порты 80 и 443 должны быть открыты из интернета.
TLS_IP=
# Адрес для служебных писем Let's Encrypt (необязательно)
TLS_EMAIL=
# 1 — тестовый сервер Let's Encrypt (сертификат браузеры не доверяют): проверить, что выпуск работает,
# не расходуя лимиты. Затем поставить 0 — боевой сертификат выпустится автоматически.
TLS_STAGING=1

# --- Резервное копирование БД (сервис backup) ---
# Каждый день в BACKUP_HOUR делается дамп базы, шифруется и выгружается на Яндекс Диск (WebDAV).
# Пока ключ и данные Яндекс Диска не заданы, контейнер backup просто простаивает (копии и письма отключены).

# Публичный ключ age (строка age1...). Приватный ключ хранится ТОЛЬКО у вас, не на сервере —
# без него копии не расшифровать. Как сгенерировать — в README, раздел «Резервное копирование».
BACKUP_AGE_PUBLIC_KEY=
# Яндекс Диск по WebDAV: логин — полный адрес почты, пароль — «пароль приложения» типа «Файлы WebDAV»
# (Яндекс ID → Безопасность → Пароли приложений), а не пароль от почты.
BACKUP_WEBDAV_USER=
BACKUP_WEBDAV_PASSWORD=
# Папка на диске, куда складываются копии (создаётся автоматически)
BACKUP_REMOTE_DIR=EquipmentTracker/backups
# Час запуска (0–23) и часовой пояс
BACKUP_HOUR=3
BACKUP_TIMEZONE=Europe/Moscow
# Сколько последних копий держать на сервере и сколько дней хранить на диске
BACKUP_KEEP_LOCAL=14
BACKUP_KEEP_REMOTE_DAYS=90

# --- Уведомления о сбоях резервного копирования (письмо) ---
# Получатели через запятую. Пусто — уведомления отключены (сбои будут видны только в логах).
BACKUP_NOTIFY_TO=
# SMTP для отправки. Для Яндекс Почты: smtp.yandex.ru, порт 465, безопасность ssl.
# Логин — полный адрес ящика-отправителя, пароль — «пароль приложения» типа «Почтовые клиенты»
# (это ДРУГОЙ пароль приложения, не тот, что для WebDAV; в настройках почты должен быть включён
# доступ по протоколу IMAP/SMTP с паролем приложения).
BACKUP_SMTP_HOST=smtp.yandex.ru
BACKUP_SMTP_PORT=465
BACKUP_SMTP_SECURITY=ssl
BACKUP_SMTP_USER=
BACKUP_SMTP_PASSWORD=
# От чьего имени письма; пусто — как BACKUP_SMTP_USER (Яндекс требует совпадения с логином)
BACKUP_SMTP_FROM=
